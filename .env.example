APP_NAME="Stanza Cross-Chain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# 1Click Intents API (Order 2)
# Held by D'Vaughn; obtain from partners.near-intents.org
ONECLICK_API_URL=https://api.near-intents.org
ONECLICK_JWT=

# NEAR Chain Signatures MPC (Order 2, Order 3)
# MPC derivation path ethereum-1 on NEAR mainnet
NEAR_NETWORK_ID=mainnet
NEAR_NODE_URL=https://rpc.mainnet.near.org
NEAR_MPC_CONTRACT=v1.signer
NEAR_ACCOUNT_ID=

# Base Settlement (Order 5)
BASE_CHAIN_ID=8453
BASE_RPC_URL=https://mainnet.base.org
LICENSE_REGISTRY_ADDRESS=

# PayPal Sandbox (PayPal AI Hackathon slice, Nov 2026)
# Create a sandbox app at developer.paypal.com (Dashboard > My Apps &
# Credentials > Sandbox > Create App). Never commit real values.
# Without these, POST /api/paypal/order returns 503 paypal_not_configured.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE defaults to https://api-m.sandbox.paypal.com; set only to override.
# PAYPAL_API_BASE=

# AI attestation agent (PayPal slice)
# OpenAI-compatible chat-completions key. When unset, the attestation agent
# runs on deterministic gates only and says so in the stored verdict.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

VITE_APP_NAME="${APP_NAME}"
